{
  "name": "zitetrial",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --experimental-strip-types --test src/system-model/*.test.mjs src/system-model/inference/*.test.mjs src/analyzer/*.test.mjs src/interpreter/*.test.mjs src/workspaces/*.test.mjs",
    "analyze": "node --experimental-strip-types src/analyzer/cli.ts",
    "interpret": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --experimental-strip-types src/interpreter/cli.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.1",
    "next": "16.4.0",
    "node-sql-parser": "^5.4.0",
    "openai": "^7.30.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "ts-morph": "^28.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "postcss": "^8.5.29",
    "tailwindcss": "^4.3.3",
    "typescript": "^5"
  }
}
